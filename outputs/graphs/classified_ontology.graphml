<edge source="programming_record:programming_data_csv:44" target="mstc_challenge:accelerating_business_and_management_processes_f:1739dbeef6" id="classified_as_challenge:programming_record_programming_data_csv_44">
  <data key="d11">classified_as_challenge</data>
