<edge source="programming_record:programming_data_fynsp27_wide_csv:19" target="mstc_challenge:accelerating_materials_discovery_production_and:e89fa227cf" id="classified_as_challenge:programming_record_programming_data_fynsp27_wide_csv_19">
  <data key="d11">classified_as_challenge</data>
  <data key="d12">1</data>
  <data key="d13">classification_pipeline</data>
  <data key="d14">19</data>
  <data key="d15">high</data>
  <data key="d16">True</data>
  <data key="d17">The scope focuses on AI/ML tools to predict compatibility/incompatibility of energetic materials and to build a data-driven predictive capability using multimodal surveillance and aging data (MS and FTIR). This is directly aligned with AI-accelerated materials understanding and qualification for mission-critical materials, which is the core of the “Accelerating Materials Discovery, Production, and Qualification for Strategic Deterrence” challenge, rather than nonproliferation monitoring, historical data digitization, regulatory streamlining, or facility throughput.</data>
  <data key="d18">BASELINE</data>
  <data key="d19">47405647.0</data>
  <data key="d20">NA11</data>
</edge>
