    <edge source="programming_record:programming_data_fynsp27_wide_csv:6" target="mstc_challenge:harnessing_america_s_historic_nuclear_data_and_r:6cbae10ba9" id="classified_as_challenge:programming_record_programming_data_fynsp27_wide_csv_6">
