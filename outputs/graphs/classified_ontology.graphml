    <edge source="programming_record:programming_data_fynsp27_wide_csv:40" target="mstc_challenge:strengthening_deterrence_through_attribution_of:12318fe125" id="classified_as_challenge:programming_record_programming_data_fynsp27_wide_csv_40">
