<edge source="programming_record:programming_data_fynsp27_wide_csv:57" target="mstc_challenge:streamlining_production_removing_red_tape_and_en:5c22e0a6a3" id="classified_as_challenge:programming_record_programming_data_fynsp27_wide_csv_57">
