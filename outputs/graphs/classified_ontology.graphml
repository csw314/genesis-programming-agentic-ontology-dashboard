<edge source="programming_record:programming_data_fynsp27_wide_csv:8" target="mstc_challenge:increasing_experimental_capacity_at_nuclear_rese:e9a4a1153b" id="classified_as_challenge:programming_record_programming_data_fynsp27_wide_csv_8">
  <data key="d11">classified_as_challenge</data>
  <data key="d12">1</data>
  <data key="d13">classification_pipeline</data>
  <data key="d14">8</data>
  <data key="d15">high</data>
  <data key="d16">True</data>
  <data key="d17">The scope focuses on applying machine learning to small-scale experimental weapons data and integral experiments, specifically for analysis and interpretation of weapon physics data. This aligns directly with the challenge centered on optimizing and accelerating experiments at limited-capacity nuclear research facilities using AI to analyze experimental data and improve experimental throughput. The emphasis on experimental weapons data and physics analysis fits better with experimental capacity and facility-focused AI than with archival data, business processes, threat response, or enterprise-wide design/production integration.</data>
  <data key="d18">BASELINE</data>
  <data key="d19">4178000.0</data>
  <data key="d20">NA11</data>
</edge>
