    <edge source="programming_record:programming_data_fynsp27_wide_csv:31" target="mstc_challenge:accelerating_nuclear_threat_assessment_preparedn:b962e35516" id="classified_as_challenge:programming_record_programming_data_fynsp27_wide_csv_31">
      <data key="d11">classified_as_challenge</data>
      <data key="d12">1</data>
      <data key="d13">classification_pipeline</data>
      <data key="d14">31</data>
      <data key="d15">high</data>
      <data key="d16">False</data>
      <data key="d17">The scope focuses on analyzing nuclear materials and device designs to advise and enable an effective U.S. Government response to the potential use of a nuclear threat device. This aligns directly with rapid threat assessment and response to nuclear/radiological events, matching the mission of “Accelerating Nuclear Threat Assessment, Preparedness, and Response.” The WBS and STAT context (Nuclear Counterterrorism and Incident Response, Nuclear Threat Science) further support an emergency response and threat assessment focus rather than long-term nonproliferation monitoring or AI-induced proliferation concerns.</data>
      <data key="d18">BASELINE</data>
      <data key="d19">75000000.0</data>
      <data key="d20">NA80</data>
    </edge>
