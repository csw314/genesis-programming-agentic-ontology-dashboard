    <edge source="programming_record:programming_data_fynsp27_wide_csv:57" target="mstc_challenge:accelerating_nuclear_enterprise_acquisition:5ed1760af3" id="classified_as_challenge:programming_record_programming_data_fynsp27_wide_csv_57">
