    <edge source="programming_record:programming_data_fynsp27_wide_csv:16" target="mstc_challenge:increasing_experimental_capacity_at_nuclear_rese:e9a4a1153b" id="classified_as_challenge:programming_record_programming_data_fynsp27_wide_csv_16">
      <data key="d11">classified_as_challenge</data>
      <data key="d12">1</data>
      <data key="d13">classification_pipeline</data>
      <data key="d14">16</data>
      <data key="d15">medium</data>
      <data key="d16">True</data>
      <data key="d17">The scope focuses on traditional ML for Bayesian inference on radiographs, Gaussian process models for improved uncertainty quantification, and NLTE atomic opacity model construction—core assessment science tools that enhance how experimental data are interpreted and how uncertainties are quantified. This aligns more with improving experimental analysis, throughput, and information gain (the experimental capacity challenge) than with digitizing historical archives or integrating enterprise-wide design/production. The STAT/WBS context of Secondary Assessment Technologies for stockpile research further supports a link to experiment-focused modeling and analysis rather than archival data curation or DA/PA integration.</data>
      <data key="d18">BASELINE</data>
      <data key="d19">2500000.0</data>
      <data key="d20">NA11</data>
    </edge>
