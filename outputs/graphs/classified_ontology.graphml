<edge source="sub_office:na12:a44487f5ca" target="mstc_challenge:integrating_design_and_production_operations_for:a1b61701e5" id="funds_challenge_evidence:programming_record_programming_data_csv_33">
  <data key="d11">funds_challenge_evidence</data>
  <data key="d12">1</data>
  <data key="d13">classification_pipeline</data>
  <data key="d14">33</data>
