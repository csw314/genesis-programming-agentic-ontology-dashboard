    <edge source="programming_record:programming_data_fynsp27_wide_csv:54" target="mstc_challenge:integrating_design_and_production_operations_for:a1b61701e5" id="classified_as_challenge:programming_record_programming_data_fynsp27_wide_csv_54">
      <data key="d11">classified_as_challenge</data>
