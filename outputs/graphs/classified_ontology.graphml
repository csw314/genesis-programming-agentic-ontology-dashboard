    <edge source="programming_record:programming_data_fynsp27_wide_csv:24" target="mstc_challenge:accelerating_materials_discovery_production_and:e89fa227cf" id="classified_as_challenge:programming_record_programming_data_fynsp27_wide_csv_24">
