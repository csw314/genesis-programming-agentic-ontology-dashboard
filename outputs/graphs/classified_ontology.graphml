<edge source="programming_record:programming_data_csv:45" target="mstc_challenge:cui_preventing_ai_induced_nuclear_proliferation:bbeffc2cf1" id="classified_as_challenge:programming_record_programming_data_csv_45">
  <data key="d11">classified_as_challenge</data>
