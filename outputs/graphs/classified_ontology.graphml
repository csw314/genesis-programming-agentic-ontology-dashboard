    <edge source="programming_record:programming_data_csv:23" target="mstc_challenge:increasing_experimental_capacity_at_nuclear_rese:e9a4a1153b" id="classified_as_challenge:programming_record_programming_data_csv_23">
      <data key="d11">classified_as_challenge</data>
      <data key="d12">1</data>
      <data key="d13">classification_pipeline</data>
      <data key="d14">23</data>
      <data key="d15">medium</data>
      <data key="d16">True</data>
      <data key="d17">The scope focuses on investigation of novel physics modeling for reentry systems with associated validation and uncertainty quantification (VUQ). This aligns most closely with the experimental modeling, uncertainty quantification, and digital/AI-driven facility concepts in the “Increasing Experimental Capacity at Nuclear Research Facilities” challenge, which emphasizes multi-fidelity physics models, uncertainty-aware analytics, and digital twins to improve experimental throughput. The other challenges center on design/production integration or nuclear forensics attribution, which are less directly related to reentry-physics VUQ work under a Stockpile Research and Delivery Environments WBS.</data>
      <data key="d18">BASELINE</data>
      <data key="d19">13900000.0</data>
      <data key="d20">NA11</data>
    </edge>
