    <edge source="programming_record:programming_data_fynsp27_wide_csv:3" target="mstc_challenge:increasing_experimental_capacity_at_nuclear_rese:e9a4a1153b" id="classified_as_challenge:programming_record_programming_data_fynsp27_wide_csv_3">
      <data key="d11">classified_as_challenge</data>
