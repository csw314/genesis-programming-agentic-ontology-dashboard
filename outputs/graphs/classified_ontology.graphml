  <data key="d12">1</data>
  <data key="d13">classification_pipeline</data>
  <data key="d14">31</data>
  <data key="d15">high</data>
  <data key="d16">False</data>
  <data key="d17">The scope focuses on “Automated Defect Detection of AM Structures; Machine Learning Models for AM Metal Components,” which is directly about applying AI/ML to advanced manufacturing (additive manufacturing) quality and reliability for metal components. This aligns most closely with the materials-focused challenge that aims to accelerate material development, production, and qualification using AI-driven workflows and in-process anomaly/defect detection. The WBS and STAT context (Advanced Manufacturing Development, Weapon Technology and Manufacturing Maturation) further support that this is about materials/manufacturing qualification rather than design–production integration, facility operations, regulatory streamlining, or threat response.</data>
  <data key="d18">BASELINE</data>
  <data key="d19">5750000.0</data>
  <data key="d20">NA11</data>
</edge>
<edge source="sub_office:na11:4d4029855b" target="mstc_challenge:accelerating_materials_discovery_production_and:e89fa227cf" id="funds_challenge_evidence:programming_record_programming_data_csv_32">
