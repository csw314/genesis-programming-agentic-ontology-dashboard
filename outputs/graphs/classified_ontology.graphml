    <edge source="programming_record:programming_data_fynsp27_wide_csv:30" target="mstc_challenge:safeguarding_nuclear_materials_from_proliferatio:616a01e1a8" id="classified_as_challenge:programming_record_programming_data_fynsp27_wide_csv_30">
      <data key="d11">classified_as_challenge</data>
