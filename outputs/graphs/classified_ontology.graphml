    <edge source="programming_record:programming_data_csv:6" target="mstc_challenge:accelerating_materials_discovery_production_and:e89fa227cf" id="classified_as_challenge:programming_record_programming_data_csv_6">
      <data key="d11">classified_as_challenge</data>
